---
// A photo taped into the notebook. `src` is a file name in src/assets/photos.
import { Image } from 'astro:assets';

const { src, alt, caption, size = 'normal', tilt = 'left' } = Astro.props;

const files = import.meta.glob('/src/assets/photos/*', { eager: true });
const file = files[`/src/assets/photos/${src}`];

if (!file) throw new Error(`Photo "${src}" not found in src/assets/photos`);

const cls = ['photo', size === 'small' && 'small', tilt === 'right' && 'r'].filter(Boolean).join(' ');
---
<figure class={cls}>
  <Image src={file.default} alt={alt} width={900} widths={[480, 900]} sizes="(max-width: 760px) 92vw, 26rem" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
