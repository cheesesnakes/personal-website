{
  "name": "Field Notebook (Astro)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro dev server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "nohup npm run dev -- --host 0.0.0.0 > /tmp/astro-dev.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode"]
    }
  },
  "remoteUser": "vscode"
}
